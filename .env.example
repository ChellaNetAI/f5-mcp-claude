# Copy to .env and fill in. Never commit .env
F5_HOST=192.168.1.245        # BIG-IP management IP
F5_USER=claude-ro            # use a Guest/Auditor role user (read-only)
F5_PASSWORD=change-me
F5_PORT=443
F5_VERIFY_SSL=false          # lab self-signed cert; set true if mgmt cert is trusted
F5_TIMEOUT=15
