# Copy to .env and fill in. Never commit .env
F5_HOST=192.168.1.245        # BIG-IP management IP
F5_USER=claude-ro            # dedicated read-only user (Guest/Auditor role)
F5_PASSWORD=change-me
F5_PORT=443
F5_TIMEOUT=15

# TLS verification of the BIG-IP mgmt certificate:
#  - lab with self-signed cert: leave F5_VERIFY_SSL=false (default)
#  - better: export the mgmt cert and point F5_CA_BUNDLE at it
F5_VERIFY_SSL=false
# F5_CA_BUNDLE=/path/to/bigip-mgmt-cert.pem
